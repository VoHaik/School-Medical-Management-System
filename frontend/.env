# Configure webpack dev server
# Fix for "options.allowedHosts[0] should be a non-empty string" error
HOST=localhost
PORT=3000
# Set allowed hosts for webpack dev server
WDS_SOCKET_HOST=localhost
WDS_SOCKET_PORT=3000
# Configure allowed hosts (fix for webpack dev server error)
DANGEROUSLY_DISABLE_HOST_CHECK=true
# React app configuration
REACT_APP_WDS_SOCKET_HOST=localhost
REACT_APP_WDS_SOCKET_PORT=3000
# Skip preflight check to avoid potential issues
SKIP_PREFLIGHT_CHECK=true
